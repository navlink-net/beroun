{
  "format": 1,
  "id": "browser",
  "name": "Browser",
  "version": "1.0.0",
  "system": true,
  "permissions": ["caroline.ask"],
  "icon": "icon.svg",
  "native": {
    "cmd": [
      "ic-browser",
      "http://127.0.0.1:{port}/apps/browser/chrome.html",
      "{sim}/web-shell",
      "http://127.0.0.1:{port}/apps/browser/about.html"
    ],
    "page": "chrome.html",
    "host": "browser"
  },
  "state": true,
  "capabilities": [{"name": "ExternalDisplay"}],
  "external": {
    "cmd": [
      "ic-browser",
      "http://127.0.0.1:{port}/apps/browser/big.html?ext=1",
      "{sim}/web-shell",
      "http://127.0.0.1:{port}/apps/browser/about.html"
    ],
    "env": {
      "IC_BROWSER_STRIP": "0", "IC_BROWSER_SCREEN": "external",
      "IC_BROWSER_CONTROL": "{state}/browser-ext.sock"
    },
    "state": true
  }
}
