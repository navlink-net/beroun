# Single source of truth for component versions (sourced by scripts/*.sh).
# Buildroot must pin the same values where Buildroot packages exist.
INTELLICAT_VERSION="1.0"          # the console's software (OS Beroun and its apps): Settings > About, GET /api/about
WESTON_APT_VERSION="14.0.2"       # Ubuntu package; Buildroot: BR2_PACKAGE_WESTON
LIBWPE_VERSION="1.16.3"
WPEBACKEND_FDO_VERSION="1.16.1"
WPEWEBKIT_VERSION="2.52.6"
COG_VERSION="0.18.5"
WPE_RELEASES_URL="https://wpewebkit.org/releases"
# Display geometry of the the device
SCREEN_WIDTH=640
SCREEN_HEIGHT=480
# Name of the nested Wayland socket
INTELLICAT_SOCKET="intellicat"
# The Claude provider of the assistant slot (docs/assistant-contract.md): the Claude Code CLI, from npm (scripts/claude-provision.sh)
CLAUDE_CODE_VERSION="2.1.316"
# The Codex provider of the assistant slot: the OpenAI Codex CLI, from npm (scripts/codex-provision.sh)
CODEX_CLI_VERSION="0.166.0"
# Babylon.js, the 3D library of the web layer: one pinned copy in web-shell/lib/babylon/, served at /lib/babylon/ (scripts/babylon-fetch.sh)
BABYLON_VERSION="9.33.1"
